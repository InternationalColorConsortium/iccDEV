<?xml version="1.0" encoding="UTF-8"?>
<!--
  PCS NEGATIVE for clause 8.7.1.1: the connection space is PCSLAB.

  This is the only fixture that isolates bPcsXyz.  8.7 lets a ColorSpace
  profile connect through either PCS, so a PCSLAB ColorSpace profile is a
  perfectly ordinary profile - but the chain of 8.7.1.2 ends in the RGB-to-PCSXYZ
  matrix of step c), which produces XYZ, and nothing in the chain converts it to
  Lab.  A PCSLAB profile classified as a member was once given an xform that
  wrote XYZ numbers into a port reporting Lab.  8.7.1.2 NOTE 7's handling of a
  PCSLAB-connected DESTINATION (tone map to H_target = 1.0 first) is about where
  the chain's output goes, not licence to end the chain in Lab.

  Without this fixture, bPcsXyz was the one membership term the corpus manifest
  could not fail a row on: a classifier that dropped it would still read 40/40.

  Built as a SINGLE-ATTRIBUTE DELTA of HdrColorSpaceClass.xml, the conforming
  base: the PCS and nothing else is changed - same cicpTag, same HDR Image
  metadata, same AToB0Tag/BToA0Tag pair, same description style.  That is what
  lets the fixture isolate one membership condition: a classifier that stopped
  testing it would admit this profile and would still pass every positive in
  the corpus, which is the failure Testing/HDR/hdr-corpus-manifest.tsv exists to
  catch.  Failing a membership condition makes a profile a non-member, not a
  defective profile, so nothing is reported against it.

  EXPECTED: icHdrProfileHdrContent.
-->
<IccProfile>
  <Header>
    <PreferredCMMType>ICCD</PreferredCMMType>
    <ProfileVersion>4.50</ProfileVersion>
    <ProfileDeviceClass>spac</ProfileDeviceClass>
    <DataColourSpace>RGB </DataColourSpace>
    <PCS>Lab </PCS>
    <CreationDateTime>2026-08-05T00:00:00</CreationDateTime>
    <ProfileFlags EmbeddedInFile="false" UseWithEmbeddedDataOnly="false"/>
    <DeviceAttributes ReflectiveOrTransparency="reflective" GlossyOrMatte="glossy" MediaPolarity="positive" MediaColour="colour"/>
    <RenderingIntent>Relative Colorimetric</RenderingIntent>
    <PCSIlluminant>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </PCSIlluminant>
    <ProfileCreator>ICCD</ProfileCreator>
  </Header>
  <Tags>
    <!-- Standard Bradford D65 to D50 adaptation. -->
    <chromaticAdaptationTag> <s15Fixed16ArrayType>
      <Array>
        1.047882  0.022919 -0.050201
        0.029587  0.990479 -0.017059
       -0.009232  0.015076  0.751678
      </Array>
    </s15Fixed16ArrayType> </chromaticAdaptationTag>

    <mediaWhitePointTag> <XYZArrayType>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </XYZArrayType> </mediaWhitePointTag>

    <cicpTag> <cicpType>
      <cicpFields ColorPrimaries="1" TransferCharacteristics="16" MatrixCoefficients="0" VideoFullRangeFlag="1"/>
    </cicpType> </cicpTag>

    <metaDataTag> <dictType>
      <DictEntry Name="CRWL" Value="203.0"/>
      <DictEntry Name="CLL" Value="1000.0 400.0 9"/>
      <DictEntry Name="MDCV" Value="1000.0 0.005 9"/>
    </dictType> </metaDataTag>

    <!-- There are no TRC tags and no matrix column tags, and under the
         23-09-2026 revision that is not a prohibition being obeyed - it is
         what a ColorSpace profile IS. 8.7 never defines either set for this
         class, so, in the revision's words, "there is nothing for this
         amendment to prohibit". The transfer comes from the cicpTag's
         TransferCharacteristics field and the primaries from its
         ColourPrimaries field; 8.7.1.1 says the cicpTag "is the only tag that
         can convey either".

         The AToB0Tag/BToA0Tag pair below is required by 8.7 of every
         ColorSpace profile, which 8.7.1.5 leans on rather than restates -
         "both already unconditionally required of every ColorSpace profile by
         8.7" - and it is what gives a legacy CMM a rendering path. Identity B
         curves: these fixtures exercise classification and the tone-mapping
         chain, not the bake's accuracy. -->

    <AToB0Tag> <lutAtoBType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutAtoBType> </AToB0Tag>

    <BToA0Tag> <lutBtoAType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutBtoAType> </BToA0Tag>

    <profileDescriptionTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[iccDEV PCS negative: PCSLAB ColorSpace profile with a PQ cicpTag, NOT an HDR ColorSpace Profile]]></LocalizedText>
    </multiLocalizedUnicodeType> </profileDescriptionTag>

    <copyrightTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[Copyright (C) 2026 The International Color Consortium. Generated fixture, no measured data.]]></LocalizedText>
    </multiLocalizedUnicodeType> </copyrightTag>
  </Tags>
</IccProfile>
