<?xml version="1.0" encoding="UTF-8"?>
<!--
  A v4 RGB ColorSpace profile carrying a headroomAdaptiveGainCurveTag ('HAGC'),
  and therefore an HDR ColorSpace Profile under clause 8.7.1.1.

  The profile exists to give the HAGC tag a profile context. The HAGC
  proposal's own clause 1.1 says "RGB data colour space, Input or Display
  class", but the 23-09-2026 HDR amendment places the tag in a ColorSpace
  profile - 8.7.1.3 a) ranks it first among tone-mapping descriptors and
  8.7.1.5 lists it as permitted content - and that is PROPOSAL-ISSUE HDR-22,
  ruled in favour of the HDR clauses. This fixture is the positive that pins
  the ruling: a build that read the HAGC class list as exhaustive reports it
  NonCompliant, and the qa manifest expects `valid`.

  The embedded and not-independent header flags are set because the curve here
  is authored as image-specific.

  The HAGC metadata exercises the full layout: a custom HDR reference white
  (which shifts every later field by two bytes), custom chromaticities (which
  add sixteen bytes only in mode 3), two alternate images, component mixing
  type 3 with a partly populated coefficient array (its length is the count of
  non-zero coefficients and is not stored anywhere), and both slope forms -
  alternate 0 carries explicit angles, alternate 1 leaves them to be derived.

  Alternate 0 tone maps down from the 3.0 stop baseline to SDR, so all of its
  control point Y values are negative; alternate 1 sits above the baseline, so
  its Y values are positive. That sign is not carried in the encoding: it is
  re-derived from the headroom ordering on every read (proposal 0.1.3.6), so
  authoring it the other way round would be reported by Validate().
-->
<IccProfile>
  <Header>
    <PreferredCMMType>iccd</PreferredCMMType>
    <ProfileVersion>4.40</ProfileVersion>
    <ProfileDeviceClass>spac</ProfileDeviceClass>
    <DataColourSpace>RGB </DataColourSpace>
    <PCS>XYZ </PCS>
    <CreationDateTime>2026-08-05T00:00:00</CreationDateTime>
    <ProfileFlags EmbeddedInFile="true" UseWithEmbeddedDataOnly="true"/>
    <DeviceAttributes ReflectiveOrTransparency="reflective" GlossyOrMatte="glossy" MediaPolarity="positive" MediaColour="colour"/>
    <RenderingIntent>Relative Colorimetric</RenderingIntent>
    <PCSIlluminant>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </PCSIlluminant>
    <ProfileCreator>iccd</ProfileCreator>
  </Header>
  <Tags>
    <mediaWhitePointTag> <XYZArrayType>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </XYZArrayType> </mediaWhitePointTag>

    <cicpTag> <cicpType>
      <cicpFields ColorPrimaries="9" TransferCharacteristics="16" MatrixCoefficients="0" VideoFullRangeFlag="1"/>
    </cicpType> </cicpTag>

    <headroomAdaptiveGainCurveTag> <headroomAdaptiveGainCurveType>
      <HagcMetadata ApplicationVersion="3" MinApplicationVersion="1"
                    HDRReferenceWhite="300.0000"
                    BaselineHeadroom="3.0000" HeadroomAdaptiveToneMap="true"
                    ChromaticitiesMode="3" CommonComponentMixing="false" CommonCurveParameters="false">
       <Chromaticities>0.708000 0.292000 0.170000 0.797000 0.131000 0.046000 0.312700 0.329000</Chromaticities>
       <AlternateImage Headroom="0.0000" ComponentMixingType="3" PchipSlope="false">
        <Coefficients kRed="0.250000" kGreen="0.500000" kBlue="0.000000" kMax="0.250000" kMin="0.000000" kComponent="0.000000"/>
        <ControlPoints>
         <ControlPoint X="0.2500" Y="-0.10000" M="-0.400000"/>
         <ControlPoint X="0.5000" Y="-0.20000" M="-0.300000"/>
         <ControlPoint X="0.7500" Y="-0.30000" M="-0.200000"/>
         <ControlPoint X="1.0000" Y="-0.40000" M="-0.100000"/>
        </ControlPoints>
       </AlternateImage>
       <AlternateImage Headroom="5.0000" ComponentMixingType="2" PchipSlope="true">
        <ControlPoints>
         <ControlPoint X="0.5000" Y="0.20000"/>
         <ControlPoint X="1.0000" Y="0.40000"/>
         <ControlPoint X="1.5000" Y="0.60000"/>
        </ControlPoints>
       </AlternateImage>
      </HagcMetadata>
    </headroomAdaptiveGainCurveType> </headroomAdaptiveGainCurveTag>

    <!-- There are no TRC tags and no matrix column tags, and under the
         23-09-2026 revision that is not a prohibition being obeyed - it is
         what a ColorSpace profile IS. 8.7 never defines either set for this
         class, so, in the revision's words, "there is nothing for this
         amendment to prohibit". The transfer comes from the cicpTag's
         TransferCharacteristics field and the primaries from its
         ColourPrimaries field; 8.7.1.1 says the cicpTag "is the only tag that
         can convey either".

         The AToB0Tag/BToA0Tag pair below is required by 8.7 of every
         ColorSpace profile, which 8.7.1.5 leans on rather than restates -
         "both already unconditionally required of every ColorSpace profile by
         8.7" - and it is what gives a legacy CMM a rendering path. Identity B
         curves: these fixtures exercise classification and the tone-mapping
         chain, not the bake's accuracy. -->

    <AToB0Tag> <lutAtoBType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutAtoBType> </AToB0Tag>

    <BToA0Tag> <lutBtoAType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutBtoAType> </BToA0Tag>

    <profileDescriptionTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[HDR ColorSpace Profile (synthetic): PQ, BT.2020 primaries, headroom adaptive gain curve]]></LocalizedText>
    </multiLocalizedUnicodeType> </profileDescriptionTag>

    <copyrightTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[Copyright (c) 2026 International Color Consortium. This profile is made available by International Color Consortium, with permission of International Color Consortium, and may be copied, distributed, embedded, made, used, and sold without restriction. Altered versions of this profile shall have the original identification and copyright information removed and shall not be misrepresented as the original profile.]]></LocalizedText>
    </multiLocalizedUnicodeType> </copyrightTag>
  </Tags>
</IccProfile>
