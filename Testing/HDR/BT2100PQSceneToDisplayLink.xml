    </multiLocalizedUnicodeType> </profileDescriptionTag>
	
	<AToB0Tag> <multiProcessElementType>
	  <MultiProcessElements InputChannels="3" OutputChannels="3">
      <!-- Normalized Camera (scene) RGB Here -->
			
			 <!-- Apply PQ OOTF Part 1 (E' = BT.709 OETF of 59.5208 * E) -->
		  <CurveSetElement InputChannels="3" OutputChannels="3">
			  <SegmentedCurve>
				  <FormulaSegment Start="-infinity" End="0.0" FunctionType="0">1 0 0 0</FormulaSegment>
				  <FormulaSegment Start="0" End="0.0003024" FunctionType="0">1 267.84 0 0</FormulaSegment>
				  <FormulaSegment Start="0.0003024" End="+infinity" FunctionType="3">0.45 1.099 59.5208 0 -0.099 </FormulaSegment>
				</SegmentedCurve>
			  <DuplicateCurve Index="0"/>
			  <DuplicateCurve Index="0"/>
			</CurveSetElement>

		  <!-- Apply PQ OOTF Part 2 (100 * E'^2.4) -->
		  <CurveSetElement InputChannels="3" OutputChannels="3">
			  <SegmentedCurve>
				  <FormulaSegment Start="-infinity" End="0.0" FunctionType="0">1 0 0 0</FormulaSegment>
				  <FormulaSegment Start="0" End="+infinity" FunctionType="3">2.4 100 1 0 0</FormulaSegment>
				</SegmentedCurve>
			  <DuplicateCurve Index="0"/>
			  <DuplicateCurve Index="0"/>
			</CurveSetElement>
			
		  <!-- Apply Inverse PQ EOTF (Part 1 - divide input by 10000) -->
			<MatrixElement InputChannels="3" OutputChannels="3">
			  <MatrixData>
				  0.0001 0 0
          0 0.0001 0
          0 0 0.0001
				</MatrixData>
			</MatrixElement>
			
		  <!-- Apply Inverse PQ EOTF (Part 2) -->
		  <CurveSetElement InputChannels="3" OutputChannels="3">
			  <SegmentedCurve>
				  <FormulaSegment Start="-infinity" End="0.0" FunctionType="0">1 0 0 0</FormulaSegment>
				  <FormulaSegment Start="0" End="+infinity" FunctionType="7">78.84375 0.1593017578125 0.8359375 18.8515625 18.6875 1.0</FormulaSegment>
				</SegmentedCurve>
			  <DuplicateCurve Index="0"/>
			  <DuplicateCurve Index="0"/>
			</CurveSetElement>

      <!-- PQ Full RGB Here -->

		  <!-- Apply PQ EOTF (ST 2084): function type 6 with w = 1/m1 and g = 1/m2 -->
		  <CurveSetElement InputChannels="3" OutputChannels="3">
			  <SegmentedCurve>
				  <FormulaSegment Start="-infinity" End="0.0" FunctionType="0">1 0 0 0</FormulaSegment>
				  <FormulaSegment Start="0" End="+infinity" FunctionType="6">6.277394636015326 0.01268331351565597 0.8359375 18.8515625 18.6875 10000 1.0</FormulaSegment>
				</SegmentedCurve>
			  <DuplicateCurve Index="0"/>
			  <DuplicateCurve Index="0"/>
			</CurveSetElement>

		  <!-- Normalize to display range [0.0, 1.0] -->
			<MatrixElement InputChannels="3" OutputChannels="3">
			  <MatrixData>
				  0.0001 0 0
          0 0.0001 0
          0 0 0.0001
				</MatrixData>
			</MatrixElement>
			
      <!-- Normalized Display RGB Here -->
	  </MultiProcessElements>
	</multiProcessElementType> </AToB0Tag>
	
