<?xml version="1.0" encoding="UTF-8"?>
<!--
  A conforming RGB HDR Display profile whose cicpTag declares ColourPrimaries 2
  (Unspecified). This is the fixture for the CICP amendment to clauses 9.2.17
  and 10.3.

  Under ITU-T H.273 alone, value 2 means "image characteristics are unknown or
  are determined by the application". The amendment specifies, for the ICC
  application, exactly how they are determined: the source primaries are
  recovered from this profile's own red/green/blue colorant tags, media white
  point, and chromaticAdaptationTag.

  What makes this fixture worth having rather than the no-chad case is the
  adaptation direction. The colorants here are the sRGB/BT.709 primaries
  adapted to the PCS adopted white, and the chromaticAdaptationTag is the
  Bradford matrix that adapted them. Clause 10.3 NOTE 1 asks for values
  relative to the profile's ACTUAL adopted white, so recovering them means
  applying that matrix INVERTED. Do it correctly and the recovered
  chromaticities come back at BT.709 primaries with a D65 white, matching the
  H.273 Table 2 entry for value 1. Skip the inverse, or apply it forwards, and
  the result is still a plausible set of chromaticities, just D50 ones - which
  is precisely the failure a fixture without a chromaticAdaptationTag cannot
  detect.

  Compare HagcHexData.xml, which is the other branch: ColourPrimaries 2 with no
  chromaticAdaptationTag at all, where NOTE 2 applies and the recovered white
  is legitimately D50.
-->
<IccProfile>
  <Header>
    <PreferredCMMType>ICCD</PreferredCMMType>
    <ProfileVersion>4.50</ProfileVersion>
    <ProfileDeviceClass>mntr</ProfileDeviceClass>
    <DataColourSpace>RGB </DataColourSpace>
    <PCS>XYZ </PCS>
    <CreationDateTime>2026-08-05T00:00:00</CreationDateTime>
    <ProfileFlags EmbeddedInFile="false" UseWithEmbeddedDataOnly="false"/>
    <DeviceAttributes ReflectiveOrTransparency="reflective" GlossyOrMatte="glossy" MediaPolarity="positive" MediaColour="colour"/>
    <RenderingIntent>Relative Colorimetric</RenderingIntent>
    <PCSIlluminant>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </PCSIlluminant>
    <ProfileCreator>ICCD</ProfileCreator>
  </Header>
  <Tags>
    <!-- The canonical sRGB/BT.709 colorants adapted to the PCS adopted white,
         which is what a conforming v4 matrix profile carries: the encoded values
         are relative to D50, not to the display's own D65. The
         chromaticAdaptationTag below is the matrix that put them there, so a
         consumer recovering the source primaries per clause 10.3 NOTE 1 has to
         apply its inverse to get back to D65. -->
    <redColorantTag> <XYZArrayType>
      <XYZNumber X="0.436004638672" Y="0.222503662109" Z="0.013900756836"/>
    </XYZArrayType> </redColorantTag>

    <greenColorantTag> <XYZArrayType>
      <XYZNumber X="0.385101318359" Y="0.716903686523" Z="0.097106933594"/>
    </XYZArrayType> </greenColorantTag>

    <blueColorantTag> <XYZArrayType>
      <XYZNumber X="0.143096923828" Y="0.060592651367" Z="0.713897705078"/>
    </XYZArrayType> </blueColorantTag>

    <!-- Standard Bradford D65 to D50 adaptation. -->
    <chromaticAdaptationTag> <s15Fixed16ArrayType>
      <Array>
        1.047882  0.022919 -0.050201
        0.029587  0.990479 -0.017059
       -0.009232  0.015076  0.751678
      </Array>
    </s15Fixed16ArrayType> </chromaticAdaptationTag>

    <redTRCTag> <parametricCurveType>
      <ParametricCurve FunctionType="0">2.2</ParametricCurve>
    </parametricCurveType> </redTRCTag>

    <greenTRCTag> <parametricCurveType>
      <ParametricCurve FunctionType="0">2.2</ParametricCurve>
    </parametricCurveType> </greenTRCTag>

    <blueTRCTag> <parametricCurveType>
      <ParametricCurve FunctionType="0">2.2</ParametricCurve>
    </parametricCurveType> </blueTRCTag>

    <mediaWhitePointTag> <XYZArrayType>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </XYZArrayType> </mediaWhitePointTag>

    <cicpTag> <cicpType>
      <cicpFields ColorPrimaries="2" TransferCharacteristics="16" MatrixCoefficients="0" VideoFullRangeFlag="1"/>
    </cicpType> </cicpTag>

    <profileDescriptionTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[iccDEV HDR display profile with cicp ColourPrimaries 2 (Unspecified)]]></LocalizedText>
    </multiLocalizedUnicodeType> </profileDescriptionTag>

    <copyrightTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[Copyright (C) 2026 The International Color Consortium. Generated fixture, no measured data.]]></LocalizedText>
    </multiLocalizedUnicodeType> </copyrightTag>
  </Tags>
</IccProfile>
