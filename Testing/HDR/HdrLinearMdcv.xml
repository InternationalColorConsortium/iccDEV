<!--
  A conforming RGB HDR Display profile whose cicpTag declares the Linear (8)
  transfer characteristic, written for the content-headroom priority order that
  clause 8.10.4 states for Linear and for Linear only.

  Why Linear needs an order at all: PQ carries a 10 000 cd/m2 peak in the
  transfer function itself and HLG a nominal one, so for those two the content
  peak is already established. Linear establishes nothing, so without an
  assumed peak the tone-mapping operator of 8.10.2 has no scale to work in and
  8.10.4 supplies one:

    a) CLL present               ->  Hcontent = CLL.max / CRWL
    b) CLL absent, MDCV present  ->  Hcontent = MDCV.max / CRWL
    c) neither present           ->  Hcontent = 1000 cd/m2 / CRWL

  The TRC tags are the 1.0 identity rather than the 2.2 the other fixtures
  carry, because a Linear profile's encoding is already linear-light.

  NOTE the wider fixture question this does not settle: the 29-08-2026 revision
  of the amendment removes the TRC tags from an HDR Profile's required set, and
  ten fixtures in this directory - these four included - still carry them. That
  is register item B5 in docs/notes/2026-09-01-hdr-implementation-work-brief.md
  and it is deliberately not decided here; these follow the existing style so
  the whole set can be corrected in one pass once it is.

  THIS FIXTURE exercises rule b): MDCV is present, CLL is not.

    CRWL 100, MDCV.max 4000  ->  4000/100 = 40,0

  The CRWL is deliberately NOT 203. Every branch of the order divides by the
  content reference white, and 203 is also its default, so a fixture that used
  the default could not distinguish "divided by the CRWL entry" from "divided
  by the default" - the arithmetic would be identical.
-->
<IccProfile>
  <Header>
    <PreferredCMMType>ICCD</PreferredCMMType>
    <ProfileVersion>4.50</ProfileVersion>
    <ProfileDeviceClass>mntr</ProfileDeviceClass>
    <DataColourSpace>RGB </DataColourSpace>
    <PCS>XYZ </PCS>
    <CreationDateTime>2026-09-01T00:00:00</CreationDateTime>
    <ProfileFlags EmbeddedInFile="false" UseWithEmbeddedDataOnly="false"/>
    <DeviceAttributes ReflectiveOrTransparency="reflective" GlossyOrMatte="glossy" MediaPolarity="positive" MediaColour="colour"/>
    <RenderingIntent>Relative Colorimetric</RenderingIntent>
    <PCSIlluminant>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </PCSIlluminant>
    <ProfileCreator>ICCD</ProfileCreator>
  </Header>
  <Tags>
    <!-- The same sRGB/BT.709 colorants, chad and TRC tags every other fixture in
         this directory carries, so that the only thing distinguishing these four
         from one another is the metadata the content-headroom order reads. -->
    <redColorantTag> <XYZArrayType>
      <XYZNumber X="0.436004638672" Y="0.222503662109" Z="0.013900756836"/>
    </XYZArrayType> </redColorantTag>

    <greenColorantTag> <XYZArrayType>
      <XYZNumber X="0.385101318359" Y="0.716903686523" Z="0.097106933594"/>
    </XYZArrayType> </greenColorantTag>

    <blueColorantTag> <XYZArrayType>
      <XYZNumber X="0.143096923828" Y="0.060592651367" Z="0.713897705078"/>
    </XYZArrayType> </blueColorantTag>

    <chromaticAdaptationTag> <s15Fixed16ArrayType>
      <Array>
        1.047882  0.022919 -0.050201
        0.029587  0.990479 -0.017059
       -0.009232  0.015076  0.751678
      </Array>
    </s15Fixed16ArrayType> </chromaticAdaptationTag>

    <mediaWhitePointTag> <XYZArrayType>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </XYZArrayType> </mediaWhitePointTag>

    <cicpTag> <cicpType>
      <cicpFields ColorPrimaries="1" TransferCharacteristics="8" MatrixCoefficients="0" VideoFullRangeFlag="1"/>
    </cicpType> </cicpTag>

    <metaDataTag> <dictType>
      <DictEntry Name="CRWL" Value="100.0"/>
      <DictEntry Name="MDCV" Value="4000.0 0.005 9"/>
    </dictType> </metaDataTag>

    <!-- Clause 8.10.1 of the 29-08-2026 revision: "the redTRCTag, greenTRCTag
         and blueTRCTag shall not be present" in an HDR Profile. The transfer
         function is conveyed by the cicpTag's TransferCharacteristics field
         instead, and NOTE 3 makes their absence one of the two tag-level
         features that distinguish an HDR Profile. This fixture was authored
         against the previous revision and carried them.

         The AToB0Tag/BToA0Tag pair below is what 8.10.6 makes mandatory, and
         what NOTE 4 says gives a legacy CMM "a rendering path at all" once the
         TRC tags are gone. Identity B curves: these fixtures exercise
         classification and the tone-mapping chain, not the bake's accuracy. -->

    <AToB0Tag> <lutAtoBType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutAtoBType> </AToB0Tag>

    <BToA0Tag> <lutBtoAType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutBtoAType> </BToA0Tag>

    <profileDescriptionTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[iccDEV Linear HDR profile: content headroom from MDCV (clause 8.10.4 b)]]></LocalizedText>
    </multiLocalizedUnicodeType> </profileDescriptionTag>

    <copyrightTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[Copyright (C) 2026 The International Color Consortium. Generated fixture, no measured data.]]></LocalizedText>
    </multiLocalizedUnicodeType> </copyrightTag>
  </Tags>
</IccProfile>
