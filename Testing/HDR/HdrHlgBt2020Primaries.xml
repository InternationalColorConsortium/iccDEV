<?xml version="1.0" encoding="UTF-8"?>
<!--
  PAIR for IMPL-04 - the HLG OOTF's luma coefficients.  This half declares
  ColourPrimaries 9 (BT.2020); `HdrHlgBt2020Primaries.xml` is identical but
  for that field.

  WHY THE PAIR EXISTS.  SMPTE ST 2094-50 Annex A.2 NOTE 7 requires the HLG
  Reference OOTF to be applied using BT.2100 Table 2 primaries - BT.2020's -
  which taken strictly means an HLG signal in other primaries is converted INTO
  BT.2020, put through the OOTF, and converted back.  Until 2026-09-08 this
  implementation applied BT.2020's coefficients wherever the signal stood, and
  no fixture could tell: every HLG profile in the corpus declared primaries 9,
  so the correct and incorrect behaviours coincided everywhere.

  WHAT THE FIX IS.  The round trip collapses.  The OOTF is a SCALAR gain
  applied alike to all three channels - dst = src * g(Ys) - so for any
  conversion matrix M, M^-1 * (M*src * g) == src * g and the matrices cancel.
  The only thing the conversion changes is which Ys is formed, and BT.2020's
  coefficients on BT.2020 RGB are that colour's true luminance.  So NOTE 7
  reduces to forming Ys as the true luminance of the source colour: the Y row
  of the RGB-to-XYZ matrix for the primaries the signal is actually in.

  For ColourPrimaries 9 that row is 0,2627 / 0,6780 / 0,0593, which is exactly
  the constants used before - so the BT.2020 half of this pair is unchanged bit
  for bit, and the corpus's five existing HLG profiles are too.  For BT.709 it
  is 0,2126 / 0,7152 / 0,0722.

  WHAT THE PAIR DOES AND DOES NOT ISOLATE - read this before writing a test on
  it.  ColourPrimaries drives TWO things: the OOTF's luma coefficients (this
  item) and the RGB-to-PCSXYZ forward matrix.  A render through these two
  profiles therefore differs for BOTH reasons at once, and the pair CANNOT
  attribute the difference to the OOTF on its own.  It exercises the path; it
  does not isolate it.

  Isolating it needs CIccHdrTransfer directly, with everything but the
  primaries held constant.  Done that way on 2026-09-08, input 0,8 / 0,3 / 0,1:
  BT.709 gives 1,053631, BT.2020 1,087089, Display P3 1,064372 in the first
  channel.  That is the OOTF alone.

  A NEUTRAL colour cannot tell any of them apart - the coefficients sum to 1 in
  every set, so Ys = v when R = G = B, and all three return 0,249739.  So a
  test built on this pair must use a colour with unequal channels, and even
  then it is asserting the combined effect.

  Both halves are conforming HDR Display profiles and both validate clean.

  This is the CONTROL half.  Its coefficients are the ones the implementation
  used unconditionally before, so if this fixture ever moves, the change is a
  regression rather than the IMPL-04 fix.
-->
<IccProfile>
  <Header>
    <PreferredCMMType>ICCD</PreferredCMMType>
    <ProfileVersion>4.50</ProfileVersion>
    <ProfileDeviceClass>mntr</ProfileDeviceClass>
    <DataColourSpace>RGB </DataColourSpace>
    <PCS>XYZ </PCS>
    <CreationDateTime>2026-08-05T00:00:00</CreationDateTime>
    <ProfileFlags EmbeddedInFile="false" UseWithEmbeddedDataOnly="false"/>
    <DeviceAttributes ReflectiveOrTransparency="reflective" GlossyOrMatte="glossy" MediaPolarity="positive" MediaColour="colour"/>
    <RenderingIntent>Relative Colorimetric</RenderingIntent>
    <PCSIlluminant>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </PCSIlluminant>
    <ProfileCreator>ICCD</ProfileCreator>
  </Header>
  <Tags>
    <!-- The canonical sRGB/BT.709 colorants adapted to the PCS adopted white,
         which is what a conforming v4 matrix profile carries: the encoded values
         are relative to D50, not to the display's own D65. The
         chromaticAdaptationTag below is the matrix that put them there, so a
         consumer recovering the source primaries per clause 10.3 NOTE 1 has to
         apply its inverse to get back to D65. -->
    <redColorantTag> <XYZArrayType>
      <XYZNumber X="0.436004638672" Y="0.222503662109" Z="0.013900756836"/>
    </XYZArrayType> </redColorantTag>

    <greenColorantTag> <XYZArrayType>
      <XYZNumber X="0.385101318359" Y="0.716903686523" Z="0.097106933594"/>
    </XYZArrayType> </greenColorantTag>

    <blueColorantTag> <XYZArrayType>
      <XYZNumber X="0.143096923828" Y="0.060592651367" Z="0.713897705078"/>
    </XYZArrayType> </blueColorantTag>

    <!-- Standard Bradford D65 to D50 adaptation. -->
    <chromaticAdaptationTag> <s15Fixed16ArrayType>
      <Array>
        1.047882  0.022919 -0.050201
        0.029587  0.990479 -0.017059
       -0.009232  0.015076  0.751678
      </Array>
    </s15Fixed16ArrayType> </chromaticAdaptationTag>

    <mediaWhitePointTag> <XYZArrayType>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </XYZArrayType> </mediaWhitePointTag>

    <cicpTag> <cicpType>
      <cicpFields ColorPrimaries="9" TransferCharacteristics="18" MatrixCoefficients="0" VideoFullRangeFlag="1"/>
    </cicpType> </cicpTag>

    <metaDataTag> <dictType>
      <DictEntry Name="CRWL" Value="203.0"/>
      <DictEntry Name="CLL" Value="1000.0 400.0 9"/>
      <DictEntry Name="MDCV" Value="1000.0 0.005 9"/>
      <DictEntry Name="DERH" Value="4.0"/>
      <DictEntry Name="DRWL" Value="203.0"/>
      <DictEntry Name="DCV" Value="1000.0 0.005 1"/>
    </dictType> </metaDataTag>

    <!-- Clause 8.10.1 of the 29-08-2026 revision: "the redTRCTag, greenTRCTag
         and blueTRCTag shall not be present" in an HDR Profile. The transfer
         function is conveyed by the cicpTag's TransferCharacteristics field
         instead, and NOTE 3 makes their absence one of the two tag-level
         features that distinguish an HDR Profile. This fixture was authored
         against the previous revision and carried them.

         The AToB0Tag/BToA0Tag pair below is what 8.10.6 makes mandatory, and
         what NOTE 4 says gives a legacy CMM "a rendering path at all" once the
         TRC tags are gone. Identity B curves: these fixtures exercise
         classification and the tone-mapping chain, not the bake's accuracy. -->

    <AToB0Tag> <lutAtoBType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutAtoBType> </AToB0Tag>

    <BToA0Tag> <lutBtoAType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutBtoAType> </BToA0Tag>

    <profileDescriptionTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[iccDEV HDR HLG with BT.2020 primaries: the OOTF luma-coefficient control]]></LocalizedText>
    </multiLocalizedUnicodeType> </profileDescriptionTag>

    <copyrightTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[Copyright (C) 2026 The International Color Consortium. Generated fixture, no measured data.]]></LocalizedText>
    </multiLocalizedUnicodeType> </copyrightTag>
  </Tags>
</IccProfile>
