<?xml version="1.0" encoding="UTF-8"?>
<!--
  THE CLASS POSITIVE for clause 8.7.1.1, and the base conforming fixture of
  this corpus.

  A ColorSpace-class ('spac') RGB profile with a PCSXYZ connection space,
  carrying a conforming PQ cicpTag and HDR Image metadata, and the
  AToB0Tag/BToA0Tag pair that 8.7 requires of every ColorSpace profile.  That
  is the whole of 8.7.1.1's membership test: "An HDR ColorSpace Profile is a
  sub-class of the ColorSpace profile defined in 8.7", and 8.7.1.5 fixes the
  class and the data colour space.

  THIS FIXTURE WAS THE CLASS NEGATIVE, and the inversion is the single most
  useful discriminator in the corpus for the 23-09-2026 revision.  Under
  clause 8.10.1 the sub-class was built on the three-component matrix-based
  Input or Display profile, so a 'spac' profile carrying a cicpTag was
  emphatically NOT an HDR Profile, and this file existed to prove a classifier
  still tested the class.  The revision moves the parent to the ColorSpace
  profile, and the same bytes are now the positive.  A classifier left on the
  old reading fails this row; one that stopped testing the class altogether
  passes it and fails HdrDisplayMetadata and HdrInputDisplayMeta instead.

  IT ALSO USED TO WARN.  CIccProfile::CheckTagExclusion() grouped cicpTag with
  the tags that have no interpretation outside the Input, Display and
  ColorEncoding classes, so a cicpTag on 'spac' could not be carried without
  drawing a diagnostic.  4.4 of the amendment is exactly the change that ends
  that: it amends 9.2.17 to read "Input, Display, or ColorSpace".  The row for
  this fixture in Testing/qa-profile-manifest.tsv is now `valid`, and a build
  that still warns fails it.

  THE COLORANT TAGS AND THE HDR DISPLAY ENTRIES ARE GONE.  A ColorSpace
  profile defines no redMatrixColumnTag/greenMatrixColumnTag/
  blueMatrixColumnTag (8.7 never did), and carrying them on this class draws
  a tag-exclusion warning that has nothing to do with what the fixture is for.
  The DERH, DCV and DRWL entries went with clause 8.10.5, which the revision
  deletes outright.

  EXPECTED CLASSIFICATION is icHdrProfileConforming, and the expected
  validation verdict is `valid`.
-->
<IccProfile>
  <Header>
    <PreferredCMMType>ICCD</PreferredCMMType>
    <ProfileVersion>4.50</ProfileVersion>
    <ProfileDeviceClass>spac</ProfileDeviceClass>
    <DataColourSpace>RGB </DataColourSpace>
    <PCS>XYZ </PCS>
    <CreationDateTime>2026-08-05T00:00:00</CreationDateTime>
    <ProfileFlags EmbeddedInFile="false" UseWithEmbeddedDataOnly="false"/>
    <DeviceAttributes ReflectiveOrTransparency="reflective" GlossyOrMatte="glossy" MediaPolarity="positive" MediaColour="colour"/>
    <RenderingIntent>Relative Colorimetric</RenderingIntent>
    <PCSIlluminant>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </PCSIlluminant>
    <ProfileCreator>ICCD</ProfileCreator>
  </Header>
  <Tags>
    <!-- Standard Bradford D65 to D50 adaptation. -->
    <chromaticAdaptationTag> <s15Fixed16ArrayType>
      <Array>
        1.047882  0.022919 -0.050201
        0.029587  0.990479 -0.017059
       -0.009232  0.015076  0.751678
      </Array>
    </s15Fixed16ArrayType> </chromaticAdaptationTag>

    <mediaWhitePointTag> <XYZArrayType>
      <XYZNumber X="0.964202880859" Y="1.000000000000" Z="0.824905395508"/>
    </XYZArrayType> </mediaWhitePointTag>

    <cicpTag> <cicpType>
      <cicpFields ColorPrimaries="1" TransferCharacteristics="16" MatrixCoefficients="0" VideoFullRangeFlag="1"/>
    </cicpType> </cicpTag>

    <metaDataTag> <dictType>
      <DictEntry Name="CRWL" Value="203.0"/>
      <DictEntry Name="CLL" Value="1000.0 400.0 9"/>
      <DictEntry Name="MDCV" Value="1000.0 0.005 9"/>
    </dictType> </metaDataTag>

    <!-- There are no TRC tags and no matrix column tags, and under the
         23-09-2026 revision that is not a prohibition being obeyed - it is
         what a ColorSpace profile IS. 8.7 never defines either set for this
         class, so, in the revision's words, "there is nothing for this
         amendment to prohibit". The transfer comes from the cicpTag's
         TransferCharacteristics field and the primaries from its
         ColourPrimaries field; 8.7.1.1 says the cicpTag "is the only tag that
         can convey either".

         The AToB0Tag/BToA0Tag pair below is required by 8.7 of every
         ColorSpace profile, which 8.7.1.5 leans on rather than restates -
         "both already unconditionally required of every ColorSpace profile by
         8.7" - and it is what gives a legacy CMM a rendering path. Identity B
         curves: these fixtures exercise classification and the tone-mapping
         chain, not the bake's accuracy. -->

    <AToB0Tag> <lutAtoBType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutAtoBType> </AToB0Tag>

    <BToA0Tag> <lutBtoAType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutBtoAType> </BToA0Tag>

    <profileDescriptionTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[iccDEV HDR ColorSpace Profile: the clause 8.7.1.1 class positive and base fixture]]></LocalizedText>
    </multiLocalizedUnicodeType> </profileDescriptionTag>

    <copyrightTag> <multiLocalizedUnicodeType>
      <LocalizedText LanguageCountry="enUS"><![CDATA[Copyright (C) 2026 The International Color Consortium. Generated fixture, no measured data.]]></LocalizedText>
    </multiLocalizedUnicodeType> </copyrightTag>
  </Tags>
</IccProfile>
