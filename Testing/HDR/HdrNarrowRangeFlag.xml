    <!-- There are no TRC tags and no matrix column tags, and under the
         23-09-2026 revision that is not a prohibition being obeyed - it is
         what a ColorSpace profile IS. 8.7 never defines either set for this
         class, so, in the revision's words, "there is nothing for this
         amendment to prohibit". The transfer comes from the cicpTag's
         TransferCharacteristics field and the primaries from its
         ColourPrimaries field; 8.7.1.1 says the cicpTag "is the only tag that
         can convey either".

         The AToB0Tag/BToA0Tag pair below is required by 8.7 of every
         ColorSpace profile, which 8.7.1.5 leans on rather than restates -
         "both already unconditionally required of every ColorSpace profile by
         8.7" - and it is what gives a legacy CMM a rendering path. Identity B
         curves: these fixtures exercise classification and the tone-mapping
         chain, not the bake's accuracy. -->

    <AToB0Tag> <lutAtoBType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutAtoBType> </AToB0Tag>

    <BToA0Tag> <lutBtoAType>
      <Channels InputChannels="3" OutputChannels="3"/>
      <BCurves>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
        <Curve IdentitySize="2"/>
      </BCurves>
    </lutBtoAType> </BToA0Tag>

