# ---------------------------------------------------------------------------
# IccProfile
# ---------------------------------------------------------------------------

class IccProfile:
    def __init__(self, path: Optional[Union[str, bytes, os.PathLike[str], os.PathLike[bytes]]] = None, *, lazy: bool = True) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> IccProfile: ...
    def __exit__(self, exc_type: object, exc_val: object, exc_tb: object) -> bool: ...
    def __bool__(self) -> bool: ...

    @property
    def is_valid(self) -> bool: ...
    @property
    def header(self) -> IccProfileHeader: ...
    @property
    def color_space(self) -> ColorSpace: ...
    @property
    def pcs(self) -> ColorSpace: ...
    @property
    def device_class(self) -> Union[ProfileClass, int]: ...
    @property
    def version_string(self) -> str: ...
    @property
    def is_v5(self) -> bool: ...


# ---------------------------------------------------------------------------
# IccApply
# ---------------------------------------------------------------------------

class IccApply:
    def close(self) -> None: ...
    def __enter__(self) -> IccApply: ...
    def __exit__(self, exc_type: object, exc_val: object, exc_tb: object) -> bool: ...
    def __bool__(self) -> bool: ...

    def apply(self, pixel: Sequence[float]) -> list[float]: ...
    def apply_multi(self, pixels: Sequence[Sequence[float]]) -> list[list[float]]: ...
    def apply_ndarray(self, pixels: np.ndarray) -> np.ndarray: ...

    @property
    def src_channels(self) -> int: ...
    @property
    def dst_channels(self) -> int: ...


# ---------------------------------------------------------------------------
# IccCmm
# ---------------------------------------------------------------------------

class IccCmm:
    def __init__(
        self,
        src_space: Union[ColorSpace, int] = ...,
        dst_space: Union[ColorSpace, int] = ...,
        first_is_input: bool = True,
    ) -> None: ...

    def close(self) -> None: ...
    def __enter__(self) -> IccCmm: ...
    def __exit__(self, exc_type: object, exc_val: object, exc_tb: object) -> bool: ...
    def __bool__(self) -> bool: ...

    def attach(
        self,
        path: Union[str, bytes, os.PathLike[str], os.PathLike[bytes]],
        *,
        intent: Union[RenderingIntent, int] = ...,
        interp: Union[Interpolation, int] = ...,
        lut_type: Union[LutType, int] = ...,
        use_d2b: bool = True,
        use_bpc: bool = False,
    ) -> None: ...

    def attach_profile(
        self,
        path: Union[str, bytes, os.PathLike[str], os.PathLike[bytes]],
        **kwargs: object,
    ) -> None: ...

    def begin(self) -> None: ...
    def get_apply(self) -> IccApply: ...

    def apply(self, pixel: Sequence[float]) -> list[float]: ...
    def apply_multi(self, pixels: Sequence[Sequence[float]]) -> list[list[float]]: ...
    def apply_ndarray(self, pixels: np.ndarray) -> np.ndarray: ...

    @property
    def src_space(self) -> ColorSpace: ...
    @property
    def dst_space(self) -> ColorSpace: ...
    @property
    def src_channels(self) -> int: ...
    @property
    def dst_channels(self) -> int: ...
    @property
    def is_ready(self) -> bool: ...


