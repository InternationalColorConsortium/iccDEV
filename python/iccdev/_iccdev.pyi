# ---------------------------------------------------------------------------
# Exceptions
# ---------------------------------------------------------------------------

class IccError(Exception):
    status: int
    status_code: int  # backward compat alias
    status_name: str
    def __init__(self, message: str, status: int = -1) -> None: ...

class IccProfileError(IccError): ...
class IccCmmError(IccError): ...


