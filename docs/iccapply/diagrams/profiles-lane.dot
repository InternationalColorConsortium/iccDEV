digraph profiles_lane {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="#e8f1fb"];
  edge [fontname="Helvetica"];
  entry [label="argc / argv", fillcolor="#fff2cc"];
  options [label="global options\n--threads N, --ifd N\ntelemetry/evidence (when enabled)"];
  cfg [label="--cfg file\nimageFiles.srcIfd", fillcolor="#d9ead3"];
  direct [label="optional --exportcfg file\nCIccCfgImageApply"];
  sequence [label="CIccCfgProfileSequence\nfull remainder required"];
  inventory [label="select main IFD (default 0)\nbounded inventory; warn on omitted IFDs/SubIFDs", fillcolor="#fff2cc"];
  tiff [label="Open selected IFD pixels\nread embedded ICC if needed"];
  cmm [label="CreateStandard or CreateSearch\nthreaded CMM"];
  output [label="Convert pixels\nwrite one TIFF IFD", fillcolor="#d9ead3"];
  reject [label="reject", fillcolor="#f4cccc"];
  entry -> options;
  options -> cfg [label="--cfg"];
  options -> direct [label="direct"];
  cfg -> inventory;
  direct -> sequence -> inventory;
  sequence -> reject [label="remainder"];
  inventory -> reject [label="invalid or missing IFD"];
  inventory -> tiff;
  tiff -> cmm -> output;
}
