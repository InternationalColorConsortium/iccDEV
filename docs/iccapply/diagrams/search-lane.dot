digraph search_lane {
  graph [rankdir=LR, bgcolor="transparent", fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="#e8f1fb"];
  edge [fontname="Helvetica"];
  entry [label="argc / argv", fillcolor="#fff2cc"];
  global [label="strip --threads N and telemetry/evidence\noptions in any order (when enabled)"];
  cfg [label="--cfg file\nexact remaining argc", fillcolor="#d9ead3"];
  direct [label="optional export / debug\nCIccCfgDataApply"];
  sequence [label="CIccCfgSearchApply\n2 or 3 profiles"];
  cmm [label="CreateSearch"];
  pcs [label="PCS remap:\nwide encodings disable clipping"];
  apply [label="Apply each color record"];
  output [label="legacy, JSON,\nor IT8 output", fillcolor="#d9ead3"];
  reject [label="reject", fillcolor="#f4cccc"];
  entry -> global;
  global -> cfg [label="--cfg"];
  global -> direct [label="direct"];
  cfg -> sequence;
  direct -> sequence;
  sequence -> reject [label="not 2 / 3"];
  sequence -> cmm -> pcs -> apply -> output;
}
