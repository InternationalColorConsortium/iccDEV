{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "qa-flags-base",
      "hidden": true,
      "cacheVariables": {
        "ENABLE_TESTS": "ON",
        "ENABLE_TOOLS": "ON",
        "ICC_USE_ZLIB": "ON",
        "ICCDEV_ENABLE_QA_FLAGS": "ON"
      }
    },
    {
      "name": "vs2022-x64",
      "inherits": "default-base",
      "displayName": "Windows MSVC (VS2022)",
      "description": "Builds Windows executables and DLLs into bin/<Config> so tools run from the build tree without an iccDEV PATH helper.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "ICCDEV_WINDOWS_UNIFIED_RUNTIME": "ON"
      }
    },
    {
      "name": "vs2022-clangcl-x64",
      "inherits": "vs2022-x64",
      "displayName": "Windows ClangCL (VS2022)",
      "description": "Builds with the Visual Studio LLVM toolset and the same unified bin/<Config> runtime layout as vs2022-x64.",
      "toolset": "ClangCL"
    },
    {
      "name": "vs2022-x64-qa-flags",
      "inherits": ["vs2022-x64", "qa-flags-base"],
      "displayName": "Windows MSVC (VS2022) QA flags"
    },
    {
      "name": "vs2022-clangcl-x64-qa-flags",
      "inherits": ["vs2022-clangcl-x64", "qa-flags-base"],
      "displayName": "Windows ClangCL (VS2022) QA flags"
    },
    {
      "name": "vs2026-x64",
      "inherits": "vs2022-x64",
      "displayName": "Windows MSVC (VS2026)",
      "description": "Builds with the Visual Studio 2026 generator and v145 toolset for machines that have the VS2026 build tools but not the VS2022 v143 component.",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "vs2026-x64-qa-flags",
      "inherits": ["vs2026-x64", "qa-flags-base"],
      "displayName": "Windows MSVC (VS2026) QA flags"
    },
    {
      "name": "vs2022-clangcl-x64-clut-baseline-qa-flags",
      "inherits": ["vs2022-clangcl-x64-qa-flags"],
      "displayName": "Windows ClangCL (VS2022) CLUT baseline QA flags",
      "cacheVariables": {
        "ICCDEV_SUPPRESS_LEGACY_CRT_WARNINGS": "ON"
      }
    },
    {
      "name": "vs2022-clangcl-x64-avx2-qa-flags",
      "inherits": ["vs2022-clangcl-x64-clut-baseline-qa-flags"],
      "displayName": "Windows ClangCL (VS2022) AVX2 QA flags",
      "cacheVariables": {
        "ICCDEV_ENABLE_AVX2": "ON"
      }
    },
    {
      "name": "vs2022-clangcl-x64-avx2-diagnostics",
      "inherits": ["vs2022-clangcl-x64-avx2-qa-flags"],
      "displayName": "Windows ClangCL (VS2022) AVX2 diagnostics",
      "description": "Enables AVX2 CLUT dispatch and timing tracepoints for source-level debugging. Do not use this preset for throughput benchmarks.",
      "cacheVariables": {
        "ICC_AVX2_CLUT_DEBUG": "ON"
      }
    },
    {
      "name": "vs2022-clangcl-x64-avx512-qa-flags",
      "inherits": ["vs2022-clangcl-x64-avx2-qa-flags"],
      "displayName": "Windows ClangCL (VS2022) AVX-512 QA flags",
      "cacheVariables": {
        "ICCDEV_ENABLE_AVX512": "ON"
      }
    },
    {
      "name": "mingw-ucrt64-base",
      "inherits": "default-base",
      "hidden": true,
      "generator": "Ninja",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;C:/msys64/usr/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64"
      }
    },
    {
      "name": "mingw-x64",
      "inherits": "mingw-ucrt64-base",
      "displayName": "Windows MinGW UCRT64",
      "cacheVariables": {
        "ICCDEV_WINDOWS_UNIFIED_RUNTIME": "ON",
        "ENABLE_WXWIDGETS": "OFF",
        "ENABLE_CMM_TOOLS": "OFF",
        "ENABLE_IIS_TOOLS": "OFF"
