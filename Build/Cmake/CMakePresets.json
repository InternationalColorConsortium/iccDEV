    {
      "name": "macos-clang",
      "inherits": "default-base",
      "displayName": "macOS Clang",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-clang-guard-malloc",
      "inherits": "macos-clang",
      "displayName": "macOS Clang with GuardMalloc support",
      "description": "Debug tool build for DYLD_INSERT_LIBRARIES=/usr/lib/libgmalloc.dylib. Use the check-macos-guard-malloc target to verify LC_UUID load commands before running libgmalloc.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TOOLS": "ON",
        "ENABLE_MACOS_GUARD_MALLOC": "ON"
      }
    },
    {
      "name": "macos-clang-sanitizers",
      "inherits": "macos-clang",
      "displayName": "macOS Clang with ASan, UBSan, IntSan, and float sanitizers",
      "description": "Debug sanitizer build with libc++ EXTENSIVE hardening for crash and UB attribution. Keep this separate from GuardMalloc/libgmalloc runs.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TOOLS": "ON",
        "ENABLE_SANITIZERS": "ON",
        "ICCDEV_LIBCPP_HARDENING_MODE": "extensive"
      }
    },
