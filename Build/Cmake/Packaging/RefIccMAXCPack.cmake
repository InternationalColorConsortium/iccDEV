set(ICCDEV_PACKAGING_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/Packaging")
set(ICCDEV_PACKAGING_BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}/Packaging")
file(MAKE_DIRECTORY "${ICCDEV_PACKAGING_BINARY_DIR}")

string(TIMESTAMP ICCDEV_BUILD_DATE_UTC "%Y-%m-%dT%H:%M:%SZ" UTC)
if(NOT GIT_COMMIT_HASH)
  set(GIT_COMMIT_HASH "unknown")
endif()

set(ICCDEV_PACKAGE_BUILD_TYPE "${CMAKE_BUILD_TYPE}")
if(NOT ICCDEV_PACKAGE_BUILD_TYPE)
  set(ICCDEV_PACKAGE_BUILD_TYPE "multi-config")
endif()

configure_file(
  "${ICCDEV_PACKAGING_SOURCE_DIR}/README.md.in"
  "${ICCDEV_PACKAGING_BINARY_DIR}/README.md"
  @ONLY
)
configure_file(
  "${ICCDEV_PACKAGING_SOURCE_DIR}/VERSION.in"
  "${ICCDEV_PACKAGING_BINARY_DIR}/VERSION"
  @ONLY
)
configure_file(
  "${ICCDEV_PACKAGING_SOURCE_DIR}/GenerateToolCatalog.cmake.in"
  "${ICCDEV_PACKAGING_BINARY_DIR}/GenerateToolCatalog.cmake"
  @ONLY
)

set(ICCDEV_LICENSE_FILE "${PROJECT_ROOT_DIR}/LICENSE.md" CACHE FILEPATH "License file to include in runtime packages")
if(NOT EXISTS "${ICCDEV_LICENSE_FILE}")
  message(FATAL_ERROR "ICCDEV_LICENSE_FILE does not exist: ${ICCDEV_LICENSE_FILE}")
endif()

install(FILES
    "${ICCDEV_LICENSE_FILE}"
    "${ICCDEV_PACKAGING_BINARY_DIR}/README.md"
    "${ICCDEV_PACKAGING_BINARY_DIR}/VERSION"
    "${ICCDEV_PACKAGING_SOURCE_DIR}/THIRD-PARTY-NOTICES.md"
  DESTINATION "${CMAKE_INSTALL_DOCDIR}"
  COMPONENT "${ICCDEV_RUNTIME_COMPONENT}"
)
install(SCRIPT "${ICCDEV_PACKAGING_BINARY_DIR}/GenerateToolCatalog.cmake"
  COMPONENT "${ICCDEV_RUNTIME_COMPONENT}"
)

set(CPACK_PACKAGE_NAME "${PACKAGE_NAME}")
set(CPACK_PACKAGE_VENDOR "International Color Consortium")
set(CPACK_PACKAGE_CONTACT "International Color Consortium <https://color.org>")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "${PACKAGE_DESCRIPTION}")
set(CPACK_PACKAGE_DESCRIPTION_FILE "${ICCDEV_PACKAGING_BINARY_DIR}/README.md")
set(CPACK_RESOURCE_FILE_LICENSE "${ICCDEV_LICENSE_FILE}")
set(CPACK_PACKAGE_VERSION "${${PROJECT_UP_NAME}_VERSION}")
set(CPACK_PACKAGE_VERSION_MAJOR "${${PROJECT_UP_NAME}_MAJOR_VERSION}")
set(CPACK_PACKAGE_VERSION_MINOR "${${PROJECT_UP_NAME}_MINOR_VERSION}")
set(CPACK_PACKAGE_VERSION_PATCH "${${PROJECT_UP_NAME}_MICRO_VERSION}.${${PROJECT_UP_NAME}_PATCH_VERSION}")

string(TOLOWER "${CMAKE_SYSTEM_NAME}" ICCDEV_PACKAGE_SYSTEM_NAME)
if(CMAKE_SYSTEM_PROCESSOR)
  set(ICCDEV_PACKAGE_ARCH "${CMAKE_SYSTEM_PROCESSOR}")
else()
  set(ICCDEV_PACKAGE_ARCH "unknown-arch")
endif()
if(ICCDEV_PACKAGE_FLAVOR)
  set(ICCDEV_PACKAGE_FLAVOR_SUFFIX "-${ICCDEV_PACKAGE_FLAVOR}")
else()
  set(ICCDEV_PACKAGE_FLAVOR_SUFFIX "")
endif()
string(TOLOWER "${CPACK_PACKAGE_NAME}" ICCDEV_PACKAGE_BASENAME)
set(ICCDEV_PACKAGE_FILE_NAME
  "${ICCDEV_PACKAGE_BASENAME}-${CPACK_PACKAGE_VERSION}-${ICCDEV_PACKAGE_SYSTEM_NAME}-${ICCDEV_PACKAGE_ARCH}-${ICCDEV_PACKAGE_BUILD_TYPE}${ICCDEV_PACKAGE_FLAVOR_SUFFIX}"
)
set(CPACK_PACKAGE_FILE_NAME "${ICCDEV_PACKAGE_FILE_NAME}")

set(CPACK_INSTALL_CMAKE_PROJECTS
  "${CMAKE_CURRENT_BINARY_DIR};${PROJECT_NAME};${ICCDEV_RUNTIME_COMPONENT};/"
)
set(CPACK_COMPONENTS_ALL "${ICCDEV_RUNTIME_COMPONENT}")
set(CPACK_PACKAGE_CHECKSUM SHA256)

if(WIN32 OR APPLE)
  set(CPACK_GENERATOR "ZIP")
elseif(UNIX)
  set(CPACK_GENERATOR "ZIP;DEB;RPM")
else()
  set(CPACK_GENERATOR "ZIP")
endif()

set(CPACK_DEBIAN_PACKAGE_NAME "${PACKAGE_NAME}")
set(CPACK_DEBIAN_PACKAGE_SECTION "devel")
set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "International Color Consortium")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_GENERATE_SHLIBS ON)

set(CPACK_RPM_PACKAGE_NAME "${PACKAGE_NAME}")
set(CPACK_RPM_PACKAGE_GROUP "Development/Tools")
set(CPACK_RPM_PACKAGE_LICENSE "ICC")
set(CPACK_RPM_PACKAGE_AUTOREQ ON)

include(CPack)

set(ICCDEV_PACKAGE_SHA256_DEPENDS)
if(TARGET build-test-binaries)
  list(APPEND ICCDEV_PACKAGE_SHA256_DEPENDS build-test-binaries)
endif()

add_custom_target(package-sha256
  COMMAND ${CMAKE_CPACK_COMMAND}
    --config "${CMAKE_CURRENT_BINARY_DIR}/CPackConfig.cmake"
  COMMAND ${CMAKE_COMMAND}
    -DICCDEV_SHA256_OUTPUT=${CMAKE_CURRENT_BINARY_DIR}/SHA256SUMS
    -DICCDEV_SHA256_GLOB_DIR=${CMAKE_CURRENT_BINARY_DIR}
    -DICCDEV_SHA256_PREFIX=${ICCDEV_PACKAGE_FILE_NAME}
    -P "${ICCDEV_PACKAGING_SOURCE_DIR}/WriteSha256Sums.cmake"
  DEPENDS ${ICCDEV_PACKAGE_SHA256_DEPENDS}
  COMMENT "Write SHA256SUMS for generated CPack artifacts"
  VERBATIM
)
