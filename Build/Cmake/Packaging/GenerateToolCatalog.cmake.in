if(IS_ABSOLUTE "@CMAKE_INSTALL_BINDIR@")
  set(_bindir "$ENV{DESTDIR}@CMAKE_INSTALL_BINDIR@")
else()
  set(_bindir "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_BINDIR@")
endif()

if(IS_ABSOLUTE "@CMAKE_INSTALL_DOCDIR@")
  set(_docdir "$ENV{DESTDIR}@CMAKE_INSTALL_DOCDIR@")
else()
  set(_docdir "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@CMAKE_INSTALL_DOCDIR@")
endif()

file(MAKE_DIRECTORY "${_docdir}")
set(_catalog "${_docdir}/TOOL-CATALOG.md")
file(WRITE "${_catalog}" "# RefIccMAX tool catalog\n\n")
file(APPEND "${_catalog}" "Generated from installed executables.\n\n")

if(EXISTS "${_bindir}")
  file(GLOB _tool_paths LIST_DIRECTORIES false "${_bindir}/*")
  list(SORT _tool_paths)
  foreach(_tool_path IN LISTS _tool_paths)
    get_filename_component(_tool_name "${_tool_path}" NAME)
    if(_tool_name MATCHES "\\.(dll|dylib|so|pdb|lib|a)$")
      continue()
    endif()
    if(_tool_name MATCHES "\\.exe$" OR NOT _tool_name MATCHES "\\.")
      file(APPEND "${_catalog}" "- `${_tool_name}`\n")
    endif()
  endforeach()
endif()
