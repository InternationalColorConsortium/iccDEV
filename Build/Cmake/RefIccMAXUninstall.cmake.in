file(GLOB manifests LIST_DIRECTORIES false "@CMAKE_CURRENT_BINARY_DIR@/install_manifest*.txt")
if (NOT manifests)
    message(FATAL_ERROR "Cannot find install manifest in \"@CMAKE_CURRENT_BINARY_DIR@\"")
endif(NOT manifests)

set(files)
foreach(manifest ${manifests})
    file(READ "${manifest}" manifest_files)
    string(REGEX REPLACE "\n" ";" manifest_files "${manifest_files}")
    list(APPEND files ${manifest_files})
endforeach(manifest)
list(REMOVE_DUPLICATES files)
set(extra_files)
foreach(file ${files})
    get_filename_component(file_name "${file}" NAME)
    if(file_name STREQUAL "VERSION")
        get_filename_component(file_dir "${file}" DIRECTORY)
        list(APPEND extra_files "${file_dir}/TOOL-CATALOG.md")
    endif(file_name STREQUAL "VERSION")
endforeach(file)
list(APPEND files ${extra_files})
list(REMOVE_DUPLICATES files)
list(REVERSE files)
foreach (file ${files})
    message(STATUS "Uninstalling \"$ENV{DESTDIR}${file}\"")
    if (EXISTS "$ENV{DESTDIR}${file}")
        execute_process(
            COMMAND "@CMAKE_COMMAND@" -E remove "$ENV{DESTDIR}${file}"
            OUTPUT_VARIABLE rm_out
            RESULT_VARIABLE rm_retval
        )
        if(NOT ${rm_retval} EQUAL 0)
            message(FATAL_ERROR "Problem when removing \"$ENV{DESTDIR}${file}\"")
        endif (NOT ${rm_retval} EQUAL 0)
    else (EXISTS "$ENV{DESTDIR}${file}")
        message(STATUS "File \"$ENV{DESTDIR}${file}\" does not exist.")
    endif (EXISTS "$ENV{DESTDIR}${file}")
endforeach(file)
