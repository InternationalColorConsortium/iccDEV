set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

gate_paths=(.github .githooks Dockerfile 'Dockerfile.*' .dockerignore '.trivyignore*')
git diff --cached --check

if git diff --cached --quiet -- "${gate_paths[@]}"; then
  exit 0
fi

# Preflight reads working files. Refuse partial staging so it checks the
# same gated content that Git will commit.
if ! git diff --quiet -- "${gate_paths[@]}"; then
  echo "[FAIL] Staged infrastructure has unstaged changes; stage or stash those changes before committing." >&2
  exit 1
fi

echo "iccDEV pre-commit security gate"
echo "Changed CI, hook, or container files detected; running preflight checks."

if PREFLIGHT_BASE_REF=HEAD .github/scripts/preflight-safety-checks.sh --require-tools; then
  exit 0
fi

cat >&2 <<'EOF'
[FAIL] Pre-commit security gate failed.
Fix the reported issue before committing, or use --no-verify only for a
documented emergency bypass.
EOF
exit 1
