set -euo pipefail

log_file=""
for argument in "$@"; do
  case "$argument" in
    --log-file=*) log_file="${argument#--log-file=}" ;;
  esac
done

[ -n "$log_file" ] || exit 2
printf '%s\n' 'ERROR SUMMARY: 0 errors from 0 contexts' > "$log_file"
exit 1
